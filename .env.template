# MCP Backtest Environment Configuration
# Copy this file to .env and fill in your API keys

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Configuration
GOOGLE_API_KEY=your_google_api_key_here

# Anthropic Claude API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Cloudflare AI API Configuration
CLOUDFLARE_API_KEY=your_cloudflare_api_key_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Qwen API Configuration
QWEN_API_KEY=your_qwen_api_key_here

# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# MetaAPI Configuration for Live Trading
METAAPI_API_KEY=your_metaapi_api_key_here
METAAPI_ACCOUNT_ID=your_metaapi_account_id_here
METAAPI_REGION=new-york  # or 'london', 'singapore'
METAAPI_PLATFORM=mt4  # or 'mt5'

# Database Configuration
DATABASE_URL=sqlite:///backtest.db

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false
LOG_LEVEL=INFO